# 生产环境变量示例（Node 网关）
# 用法：在服务器上复制为 deploy/production.env 或写入 systemd/PM2 环境，勿提交含密钥的文件。
# 构建前端时的变量见项目根目录 .env.production.example

# —— 必用 ——
NODE_ENV=production
PORT=3001
LISTEN_HOST=0.0.0.0

# —— 静态与 FastAPI 反代（与 server/src/index.js 一致）——
SERVE_STATIC=1
FASTAPI_URL=http://127.0.0.1:8000

# —— 数据库（Prisma / server/src/db.js）——
# DATABASE_URL=postgresql://crawler_user:crawler_password@localhost:5432/crawler_db

# —— Redis（Bull，server QueueService）——
# REDIS_HOST=127.0.0.1
# REDIS_PORT=6379
# REDIS_PASSWORD=
# REDIS_DB=0

# —— 鉴权（生产务必修改默认值）——
# JWT_SECRET=请替换为长随机串
# API_KEY=请替换为长随机串
